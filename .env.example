# Copier ce fichier en ".env" (à la racine) puis remplir les valeurs.
# Le fichier .env est ignoré par git : ne jamais le commiter.

# --- MongoDB ---
MONGO_USER=healthtrack
MONGO_PASS=a_remplir
MONGO_DB=healthtrackdb

# --- Redis ---
REDIS_PASS=a_remplir

# --- MinIO ---
MINIO_USER=minioadmin
MINIO_PASS=a_remplir
MINIO_BUCKET=healthtrack-docs

# --- JWT (générer avec : openssl rand -base64 48) ---
JWT_SECRET=a_remplir
JWT_EXPIRATION=86400000

# Port hote du backend (defaut 8080). A changer si 8080 est deja occupe.
BACKEND_PORT=8080
